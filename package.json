    "react-dom": "^19.1.1",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^22.18.8",
    "@types/nodemailer": "^6.4.17",
    "@types/react": "^19.1.16",
    "@types/react-dom": "^19.1.9",
