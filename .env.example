# Postgres connection string (Neon, Supabase, Vercel Postgres, or local Docker)
DATABASE_URL="postgresql://printsign:printsign@127.0.0.1:5432/printsign?schema=public"

# Auth.js session signing secret. Generate with: openssl rand -base64 32
AUTH_SECRET="replace-me"

# Public URL of this app, used in password-reset links
APP_URL="http://localhost:3000"

# Show seeded demo passwords on the sign-in screens. Defaults to on outside production.
SHOW_DEMO_LOGINS="true"

# Optional. Printed on tax invoices when set.
COMPANY_ABN=""
COMPANY_PHONE=""

# Xero custom connection (client credentials). Leave blank to stay "not connected".
XERO_CLIENT_ID=""
XERO_CLIENT_SECRET=""

# Separate job-board app. Leave blank to allow JSON download only.
JOB_BOARD_WEBHOOK_URL=""
JOB_BOARD_WEBHOOK_SECRET=""

# Artwork storage. local (default), s3, or box.
# Auto: Box if BOX_* is complete, else S3 if S3_* is complete, else local disk.
STORAGE_DRIVER=""
ARTWORK_DIR="data/artwork"

# S3-compatible (AWS S3, Cloudflare R2, MinIO)
S3_BUCKET=""
S3_REGION="ap-southeast-2"
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""
S3_ENDPOINT=""
S3_FORCE_PATH_STYLE=""

# Box.com client-credentials (enterprise) app. One folder per job or request.
BOX_CLIENT_ID=""
BOX_CLIENT_SECRET=""
BOX_ENTERPRISE_ID=""
BOX_ROOT_FOLDER_ID="0"

# Password reset email. Without SMTP, development shows the reset link on screen.
SMTP_HOST=""
SMTP_PORT="587"
SMTP_SECURE="false"
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM="Print and Sign Co <hello@printandsignco.com.au>"
